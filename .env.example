# Copie este arquivo para .env e preencha com os dados reais da loja.
# Variáveis com prefixo VITE_ ficam visíveis no navegador: use apenas valores públicos.

# Número de WhatsApp da loja em formato internacional, somente números.
# Exemplo para o Brasil: 55 + DDD + número  ->  5571999998888
VITE_WHATSAPP_NUMBER=

# Supabase (opcional). Sem estes dois valores, a loja roda em modo de demonstração.
# Use a chave pública "anon" ou "publishable". NUNCA coloque aqui a chave service_role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final. Usado em links canônicos, sitemap e robots.txt.
VITE_SITE_URL=
